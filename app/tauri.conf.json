{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leeep Connect",
  "identifier": "in.leeep.connect",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Leeep Connect",
        "width": 380,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Leeep",
    "copyright": "© Leeep",
    "shortDescription": "Leeep remote support",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../installer/resources/meshagent.exe": "meshagent/meshagent.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../installer/hooks.nsh",
        "template": "../installer/installer-template.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY (cargo tauri signer generate; see connect/app/README.md)",
      "endpoints": [
        "https://admin.leeep.in/api/method/leeep.leeep.connect.app_update?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
